@page
@model Skillbridge.Areas.Client.Pages.CodeEditorModel

@{
    ViewData["title"] = "Editor de Código";
    Layout = "_Layout";
    
}
<link rel="stylesheet" href="~/css/areas/CodeEditor.css" />

<div class="code-editor-container">
    <div class="editor-panel">
        <div class="editor-toolbar">
            <div class="toolbar-left">
                <div class="session-info">
                    <span class="session-title">@Model.CurrentSession.Title</span>
                    <span class="session-status @(Model.CurrentSession.Active ? "active" : "inactive")">
                        <i class="bi @(Model.CurrentSession.Active ? "bi-circle-fill" : "bi-circle")"></i>
                        @(Model.CurrentSession.Active ? "Ativa" : "Inativa")
                    </span>
                </div>
            </div>
            <div class="toolbar-right">
                @if (Model.CanEdit)
                {
                    <button id="saveBtn" onclick="saveContent()">
                        <i class="bi bi-floppy"></i> Guardar
                    </button>
                    <button id="inviteBtn" class="toolbar-btn invite" onclick="openInviteModal()">
                        <i class="bi bi-person-plus"></i> Convidar
                    </button>
                    <form method="post" asp-page-handler="EndSession" onsubmit="event.preventDefault(); openConfirmModal(this, 'Tem a certeza que quer terminar esta sessão?', 'Terminar sessão')">
                        <input type="hidden" name="sessionId" id="sessionId" value="@Model.CurrentSession.Id"/>
                        <button type="submit" class="toolbar-btn end-session">
                            <i class="bi bi-x-circle"></i> Terminar Sessão
                        </button>
                    </form>
                }
            </div>
        </div>
        @*Container do Monaco Editor*@
        <div id="editor"></div>
    </div>
    @* Painel de Chat *@
    <div class="chat-panel" id="chatPanel">
        <div class="chat-header" id="chatHeader">
            <div class="chat-header-left"> 
                <i class="bi bi-chat-dots-fill"></i>
                <span>Chat da Sessão</span>
            </div>
            <div class="chat-header-right">
                <span class="chat-online-indicator" id="chatOnlineIndicator"></span>
                @*<button class="chat-toggle-btn" id="chatToggleBtn" title="Minimizar chat"> 
                    <i class="bi bi-chevron-down"></i>
                </button>*@
            </div>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="chat-messages" id="chatMessages">
                @* Mensagens carregadas do servidor *@
                @foreach (var msg in Model.ChatMessages)
                {
                    var isOwn = msg.UserId == Model.CurrentUser.Id;
                    <div class="chat-message @(isOwn ? "own" : "")" data-message-id="@msg.ChatMessageId">
                        @if (!isOwn)
                        {
                            <div class="message-avatar">
                                @msg.User.Name[0].ToString().ToUpper()
                            </div>
                        }
                        <div class="message-content">
                            @if (!isOwn)
                            {
                                <div class="message-author">@msg.User.Name</div>
                            }
                            <div class="message-bubble">
                                <span class="message-text">@msg.ChatMessageText</span>
                                <span class="message-time">@msg.SentAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="chat-input-area">
                <div class="chat-input-wrapper">
                    <input type="text"
                           id="chatInput"
                           class="chat-input"
                           placeholder="Escreve uma mensagem..."
                           maxlength="500"
                           autocomplete="off" />
                    <button id="chatSendBtn" class="chat-send-btn" title="Enviar mensagem">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Modal de Convite *@
<div class="fe-modal-overlay" id="inviteModal">
    <div class="fe-modal">
        <div class="invite-modal-header">
            <h3><i class="bi bi-person-plus"></i> Adicionar à Sessão</h3>
            <button class="modal-close" onclick="closeInviteModal()">&times;</button>
        </div>
        <div class="invite-modal-body">
            @if (!string.IsNullOrWhiteSpace(Model.InviteMessage))
            {
                <div class="invite-message @(Model.InviteError ? "error" : "success")">
                    @Model.InviteMessage
                </div>
            }
            <form method="post" asp-page-handler="AddUserToSession" id="inviteForm">
                <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                <div class="form-group">
                    <label for="userEmail">Utilizador</label>
                    <select name="userEmail" id="userEmail" required>
                        <option value="">Seleciona um utilizador...</option>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <option value="@u.Email" selected="@(@Model.SelectedUserEmail == u.Email)">
                                @u.Name (@u.Email)
                            </option>
                        }
                    </select>
                    @if (Model.AvailableUsers.Count == 0)
                    {
                        <p class="no-users">Todos os membros da organização já estão na sessão.</p>
                    }
                </div>
                <div class="invite-actions">
                    <button type="button" class="btn-cancel" onclick="closeInviteModal()">Cancelar</button>
                    <button type="submit" class="btn-confirm" @(Model.AvailableUsers.Count == 0 ? "disabled" : "")>
                        <i class="bi bi-check"></i> Adicionar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    @*Gera um campo hidden com um token de segurança para proteger o POST contra ataques CSRF (Cross-Site Request Forgery) *@
    @Html.AntiForgeryToken()
    @* --- O SignalR tem de ser primeiro porque senao vai ser carregado com modulo do Monaco --- *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    @* --- Loader do Monaco Editor via CDN --- *@
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs/loader.js"></script>

    <script>
        //Ligação ao CodeEditorHub
        const editorConnection = new signalR.HubConnectionBuilder()
            .withUrl("/codeEditorHub")
            .configureLogging(signalR.LogLevel.Warning)
            .withAutomaticReconnect()
            .build();

        const canEdit = @Json.Serialize(Model.CanEdit);

        //Arranca a ligação e junta ao grupo da sessão
        async function startEditorHub() {
            try {
                await editorConnection.start();
                await editorConnection.invoke('JoinSession', sessionId);
                console.log("CodeEditorHub Connected.");
            } catch (err) {
                console.log(err);
                setTimeout(startEditorHub, 5000);
            }
        }

        //Constantes Razor
        const sessionId = '@Model.CurrentSession.Id';
        const currentUserId = '@Model.CurrentUser.Id';
        const currentUserName = '@Model.CurrentUser.Name';
        
        startEditorHub();

        //Para o editor se tornar acessivel fora do require
        var editor; 
        
        //Configura o caminho base dos modulos do Monaco
        require.config({paths: {'vs' : 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs'}});
        //Inicializa o editor apos carregar o modulo principal
        require(['vs/editor/editor.main'], function() {
            editor = monaco.editor.create(
                //Elemento HTML onde o editor vai ser renderizado
                document.getElementById('editor'),
            {
                //Tema
                theme: 'vs-dark',
                //Conteudo do ficheiro serializado de forma a evitar problemas com aspas, caracteres especiais, etc...
                value: @Json.Serialize(@Model.FileContent),
                //Linguagem 
                //TODO fazer um map que vai buscar a linguagem a partir da extensão do ficheiro
                language: 'csharp',
                //Bloqueia a edição se o utilizador for Viewer
                readOnly: @Json.Serialize(!Model.CanEdit),
                //Qunado ha um resize mantem a prorpoçao correta do editor
                automaticLayout: true
            })
            //Flag para evitar loops
            let isFinished = false;
            //Variavel para o Throttling
            let debounceTimer = null;

            if (canEdit) {
                editor.onDidChangeModelContent(() => {
                    //ignora as alterações recebidas
                    if (isFinished) return;
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        editorConnection.invoke('SendCodeChange', sessionId, editor.getValue())
                            .catch(err => console.log("Erro ao enviar código:", err));
                    }, 150); //150ms de debouce
                });
            }
            
            //Aprendiz vai receber e aplicar as alterações
            editorConnection.on("ReceiveCodeChange", (content) => {
                if (!editor) return;
                //Sem alterações desnecessárias
                if (editor.getValue() === content) return;

                isFinished = true;
                
                //Guarda a posição do cursor
                const position = editor.getPosition();
                const scrollTop = editor.getScrollTop();
                const scrollLeft = editor.getScrollLeft();
                
                editor.setValue(content);
                
                //Restaura a posição
                if (position) editor.setPosition(position);
                editor.setScrollLeft(scrollLeft);
                editor.setScrollTop(scrollTop);
                
                isFinished = false;
            });
            
            //Força recaluclar dimensoes depois do render
            setTimeout(() => editor.layout(), 100);
        });
        
        //Envia o conteudo atual do editor para o servidor via POST
        function saveContent() {
            
            fetch(`?handler=Save&sessionId=${sessionId}`, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    //Indica que o corpo do pedido esta em JSON
                    'Content-Type': 'application/json',
                    // Token de segurança lido do campo hidden gerado pelo AntiForgeryToken
                    'RequestVerificationToken' :
                    document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                //Converte o objeto JS para JSON para enviar o corpo do pedido
                body: JSON.stringify({
                    //Conteudo atual do editor
                    content: editor.getValue(),
                    //Sessão atual
                    // sessionId: '@*@Model.CurrentSession.Id*@'
                })
            }).then(response => {
                //Mostra alerta de sucesso se o servidor devolver 200 OK
                if (response.ok) {
                    mostrarToast('Guardado', 'Conteudo gravado com sucesso!', 'success');
                } else if (response.status === 403) {
                    mostrarToast('Erro', 'Não tens permissão para guardar', 'danger');
                } else {
                    mostrarToast('Erro', 'Ocorreu um erro ao gravar!', 'danger');
                }
            });
        }
        
        // Cria a ligaçao SignalR
        const chatConnection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .configureLogging(signalR.LogLevel.Information)
            .withAutomaticReconnect()
            .build();
        
        // Elementos do DOM
        const chatMessages = document.getElementById('chatMessages');
        const chatInput = document.getElementById('chatInput');
        const chatSendBtn = document.getElementById('chatSendBtn');
        const chatToggleBtn = document.getElementById('chatToggleBtn');
        const chatBody = document.getElementById('chatBody');
        const chatPanel = document.getElementById('chatPanel');
        const chatOnlineIndicator = document.getElementById('chatOnlineIndicator');

        // Scroll automático para a última mensagem
        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
        
        // Cria um elemento de mensagem no DOM
        function createMessageElement(data) {
            const isOwn = data.userId === currentUserId;
            const msgDiv = document.createElement('div');
            msgDiv.className = `chat-message ${isOwn ? 'own' : ''}`;
            msgDiv.setAttribute('data-message-id', data.id);
            let html = '';
            if (!isOwn) {
                const initial = data.userName ? data.userName[0].toUpperCase() : '?';
                html += `<div class="message-avatar">${initial}</div>`;
            }
            html += '<div class="message-content">';
            if (!isOwn) {
                html += `<div class="message-author">${escapeHtml(data.userName)}</div>`;
            }
            html += `<div class="message-bubble">`;
            html += `<span class="message-text">${escapeHtml(data.text)}</span>`;
            html += `<span class="message-time">${data.sentAt}</span>`;
            html += `</div></div>`;
            msgDiv.innerHTML = html;
            return msgDiv;
        }
        
        // Proteção contra XSS
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Recebe mensagens do servidor
        chatConnection.on('ReceiveMessage', function (data) {
            const msgElement = createMessageElement(data);
            // Animação de entrada
            msgElement.style.opacity = '0';
            msgElement.style.transform = 'translateY(10px)';
            chatMessages.appendChild(msgElement);

            requestAnimationFrame(() => {
                msgElement.style.transition = 'all 0.3s ease';
                msgElement.style.opacity = '1';
                msgElement.style.transform = 'translateY(0)';
            });

            scrollToBottom();
        });
        
        // Inicia a conexão do chat
        async function startChat() {
            try {
                await chatConnection.start();
                console.log('Chat SignalR Connected.');
                chatOnlineIndicator.classList.add('online');
                // Junta à sessão
                await chatConnection.invoke('JoinSession', sessionId);
                scrollToBottom();
            } catch (err) {
                console.error('Erro ao conectar ao chat:', err);
                chatOnlineIndicator.classList.remove('online');
                setTimeout(startChat, 5000);
            }
        }
        
        // Envia mensagem
        async function sendMessage() {
            const message = chatInput.value.trim();
            if (!message) return;
            try {
                await chatConnection.invoke('SendMessage', sessionId, message);
                chatInput.value = '';
                chatInput.focus();
            } catch (err) {
                console.error('Erro ao enviar mensagem:', err);
            }
        }
        // Event listeners do chat
        chatSendBtn.addEventListener('click', sendMessage);
        chatInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
        /*// Toggle do chat (minimizar/expandir)
        chatToggleBtn.addEventListener('click', function () {
            chatPanel.classList.toggle('minimized');
            const icon = chatToggleBtn.querySelector('i');
            if (chatPanel.classList.contains('minimized')) {
                icon.className = 'bi bi-chevron-up';
                chatToggleBtn.title = 'Expandir chat';
            } else {
                icon.className = 'bi bi-chevron-down';
                chatToggleBtn.title = 'Minimizar chat';
                scrollToBottom();
            }
        });*/

        chatConnection.onreconnecting(() => {
            chatOnlineIndicator.classList.remove('online');
            chatOnlineIndicator.classList.add('reconnecting');
        });
        chatConnection.onreconnected(() => {
            chatOnlineIndicator.classList.remove('reconnecting');
            chatOnlineIndicator.classList.add('online');
            chatConnection.invoke('JoinSession', sessionId);
        });
        chatConnection.onclose(() => {
            chatOnlineIndicator.classList.remove('online');
        });

        
       // Terminar sessão
        function endSession() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch(`?handler=EndSession&sessionId=${sessionId}`, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'RequestVerificationToken': token
                }
            }).then(response => {
                if (response.ok || response.type === 'redirect') {
                    window.location.href = '/Project/Directory';
                } else if (response.status === 403) {
                    mostrarToast('Erro','Não tens permissão para terminar a sessão.', 'danger');
                } else {
                    mostrarToast('Erro', 'Ocorreu um erro ao terminar a sessão.', 'danger');
                }
            });
        }
        
        // Modal de convite
        function openInviteModal() {
            document.getElementById('inviteModal').classList.add('active');
        }
        function closeInviteModal() {
            document.getElementById('inviteModal').classList.remove('active');
        }

        
        scrollToBottom();
        // Inicia o chat
        startChat();
    </script>
        
}









