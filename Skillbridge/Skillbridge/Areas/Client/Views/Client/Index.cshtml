@using Skillbridge.Models.Client
@model Skillbridge.Areas.Client.Models.IndexViewModel

@{
  ViewData["Title"] = "Painel";
  Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/areas/Client.css" asp-append-version="true" />

<div class="dashboard-container">
  @if (Model.Sessions == null || Model.Sessions.Count == 0 && Model.Organizations == null || Model.Organizations.Count == 0)
  {
    <div class="empty-state">
      <i class="bi bi-inbox" style="font-size: 64px; color: rgb(56, 70, 95);"></i>
      <h3 class="text-white mt-3">Nada por aqui</h3>
      <p class="empty-text">Ainda não tens sessões ou organizações. Começa por explorar o Skillbridge!</p>
    </div>
  }
  else
  {
    <div class="dashboard-grid">

      @if (Model.Sessions != null && Model.Sessions.Count > 0)
      {
        <div class="dashboard-section" style="grid-row: span 2;">
          <div class="section-header">
            <h2 class="section-title">
              <i class="bi bi-play-circle"></i>
              Sessões de Trabalho
            </h2>
            <span class="section-badge">@Model.Sessions.Count</span>
          </div>

          <div class="sessions-list">
            @foreach (var session in Model.Sessions)
            {
              <div class="session-card @(session.Active ? "session-active" : "") @(session.Locked ? "session-locked" : "")">
                <div class="session-status-bar @(session.Active ? "status-active" : session.Locked ? "status-locked" : "status-inactive")"></div>
                <div class="session-info">
                  <div class="session-top">
                    <h3 class="session-title">@session.Title</h3>
                    @if (session.Active)
                    {
                      <span class="badge-active">Em curso</span>
                    }
                    else if (session.Locked)
                    {
                      <span class="badge-locked">Bloqueada</span>
                    }
                    else
                    {
                      <span class="badge-inactive">Inativa</span>
                    }
                  </div>
                  <p class="session-description">@session.Description</p>
                  <div class="session-meta">
                    @if (session.IsPublic)
                    {
                      <span class="meta-item">
                        <i class="bi bi-globe2"></i>
                        Público
                      </span>
                    }
                    else
                    {
                      <span class="meta-item">
                        <i class="bi bi-lock"></i>
                        Privado
                      </span>
                    }
                  </div>
                </div>
                <div class="session-action">
                  @if (session.Active && !session.Locked)
                  {
                    <button class="btn-join">
                      <i class="bi bi-arrow-right-circle"></i>
                      Entrar
                    </button>
                  }
                  else
                  {
                    <button class="btn-disabled" disabled>
                      <i class="bi bi-info-circle"></i>
                      Indisponível
                    </button>
                  }
                </div>
              </div>
            }
          </div>
        </div>
      }

      <div class="dashboard-section">
        <div class="section-header">
          <h2 class="section-title">
            <i class="bi bi-building"></i>
            Organizações
          </h2>
          @if (Model.Organizations != null && Model.Organizations.Count > 0)
          {
            <span class="section-badge">@Model.Organizations.Count</span>
          }
        </div>

        @if (Model.Organizations != null && Model.Organizations.Count > 0)
        {
          <div class="org-list">
            @foreach (var org in Model.Organizations)
            {
              <a asp-controller="Organization" asp-action="Profile" asp-route-id="@org.OrganizationId" class="org-card">
                <div class="org-logo-wrapper">
                  <img src="@org.LogoPath" alt="@org.OrganizationName" class="org-logo" />
                </div>
                <div class="org-info">
                  <h3 class="org-name">@org.OrganizationName</h3>
                  <p class="org-address">
                    <i class="bi bi-geo-alt"></i>
                    @org.OrganizationAddress
                  </p>
                </div>
                <i class="bi bi-chevron-right org-arrow"></i>
              </a>
            }
          </div>
        }
        else
        {
          <div class="empty-section">
            <i class="bi bi-building" style="font-size: 32px; color: rgb(56, 70, 95);"></i>
            <p class="empty-text">Não pertences a nenhuma organização</p>
          </div>
        }
      </div>

      <div class="dashboard-section">
        <div class="section-header">
          <h2 class="section-title">
            <i class="bi bi-repository"></i>
            Projetos
          </h2>
          @if (Model.Projects != null && Model.Projects.Count > 0)
          {
            <span class="section-badge">@Model.Projects.Count</span>
          }
        </div>

        @if (Model.Projects != null && Model.Projects.Count > 0)
        {
          <div class="project-list">
            @foreach (var project in Model.Projects)
            {
              <div class="project-card">
                <div class="project-icon">
                  <i class="bi bi-code-square"></i>
                </div>
                <div class="project-info">
                  <h3 class="project-name">@project.ProjectName</h3>
                  <p class="project-desc">@project.ProjectDescription</p>
                  <div class="project-org">
                    <i class="bi bi-building"></i>
                    @(project.Organization?.OrganizationName ?? "Sem Organização")
                    @if (project.Public)
                    {
                      <span class="project-vis public"><i class="bi bi-globe2"></i></span>
                    }
                    else
                    {
                      <span class="project-vis private"><i class="bi bi-lock"></i></span>
                    }
                  </div>
                </div>
              </div>
            }
          </div>
        }
        else
        {
          <div class="empty-section">
            <i class="bi bi-code-square" style="font-size: 32px; color: rgb(56, 70, 95);"></i>
            <p class="empty-text">Não tens projetos atribuídos</p>
          </div>
        }
      </div>

    </div>
  }
</div>
