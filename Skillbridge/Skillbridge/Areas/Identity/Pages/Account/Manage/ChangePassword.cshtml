@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="identity-title"><i class="bi bi-lock"></i> @ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="identity-card">
    <div class="identity-card-header">
        <h4 class="identity-card-title"><i class="bi bi-key"></i> Alterar palavra-passe</h4>
        <p class="identity-card-desc">Mantenha a sua conta segura com uma palavra-passe forte.</p>
    </div>

    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="identity-field">
            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Palavra-passe atual" />
                <label asp-for="Input.OldPassword" class="form-label"></label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="identity-field">
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nova palavra-passe" />
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="identity-field">
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar palavra-passe"/>
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="identity-btn identity-btn-primary identity-btn-block">
            <i class="bi bi-check-lg"></i> Atualizar palavra-passe
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
