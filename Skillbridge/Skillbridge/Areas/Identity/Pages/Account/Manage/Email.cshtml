@page
@model EmailModel
@{
    ViewData["Title"] = "Gerir Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 class="identity-title"><i class="bi bi-envelope"></i> @ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="identity-card">
    <div class="identity-card-header">
        <h4 class="identity-card-title"><i class="bi bi-envelope-at"></i> Endereço de email</h4>
        <p class="identity-card-desc">Gerir o seu endereço de email.</p>
    </div>

    <form id="email-form" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        @if (Model.IsEmailConfirmed)
        {
            <div class="identity-field">
                <div class="form-floating mb-3 input-group">
                    <input asp-for="Email" class="form-control" placeholder="Email" disabled />
                    <div class="input-group-append">
                        <span class="h-100 input-group-text"><i class="bi bi-check-circle"></i></span>
                    </div>
                    <label asp-for="Email" class="form-label"></label>
                </div>
                <span class="identity-confirmed-badge"><i class="bi bi-check-circle-fill"></i> Email verificado</span>
            </div>
        }
        else
        {
            <div class="identity-field">
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Email" disabled />
                    <label asp-for="Email" class="form-label"></label>
                </div>
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="identity-btn identity-btn-secondary identity-btn-sm">
                    <i class="bi bi-send"></i> Enviar email de verificação
                </button>
            </div>
        }

        <hr class="identity-divider" />

        <div class="identity-field">
            <div class="form-floating mb-3">
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Novo email" />
                <label asp-for="Input.NewEmail" class="form-label"></label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
        </div>

        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="identity-btn identity-btn-primary identity-btn-block">
            <i class="bi bi-pencil"></i> Alterar email
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
