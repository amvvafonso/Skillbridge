@page
@model Skillbridge.Pages.Organization.IndexModel
@{
ViewData["Title"] = "Organizações";
Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/pages/Organization.css" asp-append-version="true" />

<div class="org-search-page">
    <h1 class="search-title">Explorar Organizações</h1>
    <form method="get" id="searchForm" class="search-bar-wrapper">
        <i class="bi bi-search search-icon"></i>
        <input
            type="text"
            name="q"
            id="searchInput"
            value="@Model.Q"
            class="search-input"
            placeholder="Pesquisar por nome ou localização..."
            autofocus
        />
    </form>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="section-header">
            <h2 class="section-title" style="color: white;">
                <i class="bi bi-building"></i>
                Organizações
            </h2>
            <button type="button"
                    class="btn-create-org"
                    onclick="openCreateModal()"
                    title="Criar organização">
                <i class="bi bi-plus-lg"></i>
                <span>Nova Organização</span>
            </button>
        </div>
    }
    <div style="animation: ease-in 2s;" id="resultsContainer">
            @await Html.PartialAsync("_OrganizationResults", Model)
        </div>
        <div class="fe-modal-overlay" id="createOrgModal">
            <div class="fe-modal">
                <div class="org-modal-header">
                    <h3><i class="bi bi-building-add"></i> Criar Organização</h3>
                    <button type="button" class="modal-close" onclick="closeCreateModal()">&times;</button>
                </div>
                <form method="post" asp-page-handler="CreateOrganization" enctype="multipart/form-data">
                    <div class="org-modal-body">
                        <div asp-validation-summary="ModelOnly" class="org-validation-summary"></div>

                        <div class="org-form-group">
                            <label for="logoFile" class="org-form-label">Logo</label>
                            <div class="upload-zone" id="uploadZone" onclick="document.getElementById('logoInput').click()">
                                <img id="logoPreview" class="logo-preview" src="" alt="" style="display:none;"/>
                                <div class="upload-placeholder" id="uploadPlaceholder">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    <span>Clica ou arrasta uma imagem</span>
                                    <small>PNG, JPG até 2MB</small>
                                </div>
                            </div>
                            <input required name="logoInput" type="file" accept="image/png,image/jpeg,image/webp" id="logoInput" class="hidden-input"/>
                        </div>

                        <div class="org-form-group">
                            <label for="organizationName" class="org-form-label">Nome</label>
                            <input required name="organizationName" id="organizationName" class="org-form-input" maxlength="100"/>
                        </div>

                        <div class="org-form-group">
                            <label for="organizationAddress" class="org-form-label">Endereço</label>
                            <input required id="organizationAddress" name="organizationAddress" class="org-form-input" maxlength="200"/>
                        </div>

                        <div class="org-form-group">
                            <label for="organizationDescription" class="org-form-label">Descrição</label>
                            <textarea required id="organizationDescription" name="organizationDescription" class="org-form-input org-textarea" maxlength="1000" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="org-modal-footer">
                        <button type="button" class="org-btn-cancel" onclick="closeCreateModal()">Cancelar</button>
                        <button type="submit" class="org-btn-create">Criar</button>
                    </div>
                </form>
            </div>
        </div>
</div>


@*Gera um campo hidden com um token de segurança para proteger o POST contra ataques CSRF (Cross-Site Request Forgery) *@
@Html.AntiForgeryToken()
<script>
    const input = document.getElementById('searchInput');
    const resultsContainer = document.getElementById('resultsContainer');
    let debounceTimeout;

    // --- Modal ---
    function openCreateModal() {
        document.getElementById('createOrgModal').classList.add('active');
    }
    function closeCreateModal() {
        document.getElementById('createOrgModal').classList.remove('active');
    }

    // Reopen modal on validation errors
    document.addEventListener('DOMContentLoaded', () => {
        const hasErrors = document.querySelector('.org-validation-error') ||
                          document.querySelector('.org-validation-summary');
        if (hasErrors && hasErrors.textContent.trim() !== '') {
            openCreateModal();
        }
    });

    // Close modal on overlay click
    document.getElementById('createOrgModal').addEventListener('click', (e) => {
        if (e.target.id === 'createOrgModal') closeCreateModal();
    });

    // --- File Upload Preview ---
    const logoInput = document.getElementById('logoInput');
    const logoPreview = document.getElementById('logoPreview');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
    const uploadZone = document.getElementById('uploadZone');

    logoInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            alert('Por favor seleciona uma imagem válida.');
            logoInput.value = '';
            return;
        }

        if (file.size > 2 * 1024 * 1024) {
            alert('A imagem deve ter no máximo 2MB.');
            logoInput.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = (ev) => {
            logoPreview.src = ev.target.result;
            logoPreview.style.display = 'block';
            uploadPlaceholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
    });

    // Drag and Drop
    ['dragenter', 'dragover'].forEach(evt => {
        uploadZone.addEventListener(evt, (e) => {
            e.preventDefault();
            uploadZone.classList.add('drag-over');
        });
    });

    ['dragleave', 'drop'].forEach(evt => {
        uploadZone.addEventListener(evt, (e) => {
            e.preventDefault();
            uploadZone.classList.remove('drag-over');
        });
    });

    uploadZone.addEventListener('drop', (e) => {
        const file = e.dataTransfer.files[0];
        if (!file) return;

        const dt = new DataTransfer();
        dt.items.add(file);
        logoInput.files = dt.files;
        logoInput.dispatchEvent(new Event('change'));
    });

    // --- Search ---
    document.getElementById('searchForm').addEventListener('submit', (e) => {
        resultsContainer.innerHTML = '    <div style="display: flex; flex-direction: column; text-align: center; color: white">\n' +
            '            <p style="color: rgba(255, 255, 255, 0.5)">A Procurar...</p>\n' +
            '           <div class="spinner"></div>\n' +
            '        </div>';
        e.preventDefault();
        doSearch(input.value);
    });

    async function doSearch(q) {
        const url = `/Organization?q=${encodeURIComponent(q)}&handler=Search`;
        const res = await fetch(url, {
            headers: { 'X-Requested-With': 'fetch' }
        });

        if (!res.ok) return;

        const html = await res.text();
        setTimeout(() => {
            resultsContainer.innerHTML = html;
        }, 250)


        // atualiza a URL sem recarregar (opcional, bom para refresh/share)
        const newUrl = q ? `?q=${encodeURIComponent(q)}` : window.location.pathname;
        history.replaceState(null, '', newUrl);
    }
</script>
