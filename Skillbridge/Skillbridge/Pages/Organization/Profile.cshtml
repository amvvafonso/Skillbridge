@page "{id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Skillbridge.Models.Client
@model Skillbridge.Pages.Organization.ProfileModel
@{
    ViewData["Title"] = Model.Organization?.OrganizationName;
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/pages/OrganizationProfile.css" asp-append-version="true"/>
@if (Model.Organization != null)
{
    <div class="org-profile">

        <!-- Banner -->
        <img src="@Model.Organization.BannerPath" alt="Banner" class="org-banner"/>

        <!-- Header of organization -->
        <div class="org-header">
            <img src="?handler=Image&key=@Model.Organization.LogoPath" alt="@Model.Organization.OrganizationName"
                 class="org-logo"/>
            <div class="org-header-info w-100">
                <h1 class="org-name">@Model.Organization.OrganizationName</h1>
                <p class="org-address">
                    <i class="bi bi-geo-alt"></i>
                    @Model.Organization.OrganizationAddress
                </p>
                @if (!string.IsNullOrEmpty(Model.Organization.OrganizationOwner?.Name))
                {
                    <span class="org-owner-badge">
                        <i class="bi bi-person-fill-gear"></i>
                        Fundador: @Model.Organization.OrganizationOwner.Name
                    </span>
                }
            </div>
            @if (User.Identity.IsAuthenticated && Model.UserPerm == Role.Owner)
            {
                <div class="align-content-center">
                    <form method="post" asp-page-handler="DeleteOrganization"
                          onsubmit="event.preventDefault(); openConfirmModal(this, 'Tem a certeza que quer eliminar a organização? Esta operação vai eliminar todos os registos associados a esta organização!', 'Eliminar organização')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="organizationId" value="@Model.Organization.OrganizationId"/>
                        <button class="add-member-btn delete-btn">Eliminar organização
                            <i style="font-size: 13px" class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- Two Column Layout -->
        <div class="org-main">

            <!-- Left Column is About + Projects -->
            <div>
                <!-- About -->
                <div class="org-card">
                    <h2 class="org-card-title">
                        <i class="bi bi-info-circle"></i> Sobre
                    </h2>
                    @if (!string.IsNullOrEmpty(Model.Organization.OrganizationDescription))
                    {
                        <p class="org-description">@Model.Organization.OrganizationDescription</p>
                    }
                    else
                    {
                        <p class="org-empty">Sem descrição disponível.</p>
                    }
                </div>

                <!-- Publications -->
                <div class="org-card" style="margin-top: 24px;">
                    <h2 class="org-card-title">
                        <i class="bi bi-megaphone"></i> Publicações
                        @if (Model.UserPerm is Role.Owner or Role.Manager)
                        {
                            <button type="button" class="pub-add-btn" id="btn-toggle-post" title="Nova publicação">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        }
                    </h2>

                    <!-- Create Post Form (hidden by default) -->
                    @if (Model.UserPerm is Role.Owner or Role.Manager)
                    {
                        <form id="form-create-post" method="post" class="create-post-form" style="display:none;">
                            @Html.AntiForgeryToken()
                            <div class="create-post-inner">
                                <input type="text" asp-for="NewPostTitle" placeholder="Título" class="create-post-title"
                                       maxlength="100"/>
                                <textarea asp-for="NewPostContent" placeholder="Escreve a publicação…"
                                          class="create-post-content" maxlength="500" rows="4"></textarea>
                                <div class="create-post-footer">
                                    <span class="char-count"><span id="char-current">0</span> / 500</span>
                                    <div class="create-post-actions">
                                        <button type="button" class="create-post-cancel" id="btn-cancel-post">Cancelar
                                        </button>
                                        <button type="submit" class="create-post-submit" id="btn-submit-post">
                                            <i class="bi bi-send-fill"></i> Publicar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    }

                    @if (Model.Posts != null && Model.Posts.Count > 0)
                    {
                        <div class="pub-list">
                            @foreach (var post in Model.Posts)
                            {
                                <div class="pub-post" data-post-id="@post.Id">
                                    <div class="pub-post-header">
                                        <h3 class="pub-post-title">@post.Title</h3>
                                        <div class="pub-post-meta">
                                            <span class="pub-post-date">
                                                <i class="bi bi-calendar3"></i>
                                                @post.Created.ToString("dd/MM/yyyy")
                                            </span>
                                            @* Botão de eliminar publicação — só visível para Owner e Manager *@
                                            @if (Model.UserPerm is Role.Owner or Role.Manager)
                                            {
                                                <button type="button" class="pub-delete-btn" data-post-id="@post.Id"
                                                        title="Remover publicação">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <p class="pub-post-content">@post.Content</p>
                                    @if (!string.IsNullOrEmpty(post.AuthorName))
                                    {
                                        <div class="pub-post-author">
                                            <i class="bi bi-person"></i>
                                            Publicado por @post.AuthorName
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div id="post-placeholder" class="pub-placeholder">
                            <i class="bi bi-newspaper"></i>
                            <p>Em breve — anúncios e publicações da organização aparecerão aqui.</p>
                        </div>
                    }
                </div>

                <!-- Projects -->
                <div class="org-card" style="margin-top: 24px;">
                    <h2 class="org-card-title">
                        <i class="bi bi-code-square"></i> Projetos
                        @if (Model.Projects.Count > 0)
                        {
                            <span class="project-badge public" style="margin-left: auto;">@Model.Projects.Count</span>
                        }
                        @if (Model.UserPerm is Role.Owner or Role.Manager)
                        {
                            <button type="button" class="pub-add-btn" id="btn-toggle-project" title="Novo projeto">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        }
                    </h2>

                    <!-- Create Project Form (hidden by default) -->
                    @if (Model.UserPerm is Role.Owner or Role.Manager)
                    {
                        <form id="form-create-project" method="post" class="create-project-form" style="display:none;">
                            @Html.AntiForgeryToken()
                            <div class="create-project-inner">
                                <input type="text" asp-for="NewProjectName" placeholder="Nome do projeto"
                                       class="create-project-name" maxlength="200"/>
                                <textarea asp-for="NewProjectDescription" placeholder="Descreve o projeto…"
                                          class="create-project-description" maxlength="200" rows="3"></textarea>
                                <input type="text" asp-for="NewProjectRepository"
                                       placeholder="Link do GitHub (opcional)" class="create-project-repository"/>
                                <div class="create-project-toggle">
                                    <label class="toggle-switch">
                                        <input type="checkbox" asp-for="NewProjectPublic" checked/>
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span class="toggle-label">
                                        <i class="bi bi-@(Model.NewProjectPublic ? "globe2" : "lock")"></i>
                                        <span id="visibility-text">Público</span>
                                    </span>
                                </div>
                                <div class="create-project-footer">
                                    <span class="char-count"><span id="project-char-current">0</span> / 200</span>
                                    <div class="create-project-actions">
                                        <button type="button" class="create-project-cancel" id="btn-cancel-project">
                                            Cancelar
                                        </button>
                                        <button type="submit" class="create-project-submit" id="btn-submit-project">
                                            <i class="bi bi-plus-circle"></i> Criar Projeto
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    }

                    @if (Model.Projects.Count > 0)
                    {
                        <div class="projects-grid">
                            @foreach (var project in Model.Projects)
                            {
                                <div asp-route-id="@project.Id" class="project-card">
                                    <h3 class="project-name">@project.Name</h3>
                                    <p class="project-desc">@project.Description</p>
                                    <span class="project-badge @(project.IsPublic ? "public" : "private")">
                                        <i class="bi bi-@(project.IsPublic ? "globe2" : "lock")"></i> @(project.IsPublic ? "Público" : "Privado")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="org-empty" id="project-placeholder">Esta organização ainda não tem projetos.</p>
                    }
                </div>
            </div>

            <!-- Right Column is nembers of organization -->
            <div>
                <div class="org-card">
                    <h2 class="org-card-title">
                        <i class="bi bi-people"></i> Membros
                        @if (Model.Members.Count > 0)
                        {
                            <span class="project-badge public" style="margin-left: auto;">@Model.Members.Count</span>
                        }
                    </h2>
                    @if (Model.Members.Count > 0)
                    {
                        <div class="members-list">
                            @foreach (var member in Model.Members)
                            {
                                <div id="row-@member.UserId" class="member-row">
                                    <div class="member-avatar">
                                        @(member.Name?.Length > 0 ? member.Name[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <p class="member-name">@member.Name <span
                                                class="member-role">@member.Role</span></p>
                                        <p class="member-email">@member.Email</p>
                                    </div>
                                    @* Mostra os botões de ação apenas se:
                                            - o membro não for Owner (Owner não pode ser alterado)
                                            - e o utilizador atual for Owner OU for Manager a promover um Aprendiz *@
                                    @if (member.Role != Role.Owner && (Model.UserPerm == Role.Owner || Model.UserPerm == Role.Manager && member.Role == Role.Apprentice))
                                    {
                                        <div class="remove-member-btn-div">
                                            @* Formulário de upgrade de role *@
                                            <form class="upgrade-member-form" method="post"
                                                  asp-page-handler="UpgradeMember">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="organizationId"
                                                       value="@Model.Organization.OrganizationId"/>
                                                <input type="hidden" name="memberId" value="@member.UserId"/>
                                                <button class="upgrade-member-btn" type="submit"
                                                        title="Promover membro">
                                                    <i class="bi bi-arrow-up-circle-fill"></i>
                                                </button>
                                            </form>
                                            @* Formulário de remoção de membro *@
                                            <form class="remove-member-form" method="post"
                                                  asp-page-handler="RemoveMember">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="organizationId"
                                                       value="@Model.Organization.OrganizationId"/>
                                                <input type="hidden" name="user" value="@member.Name"/>
                                                <input type="hidden" name="memberId" value="@member.UserId"/>
                                                <button class="remove-member-btn" type="submit">
                                                    <i class="bi bi-person-dash-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (Model.UserPerm == Role.Manager || Model.UserPerm == Role.Owner)
                        {
                            <form id="form-add-member" method="post" class="add-member-form">
                                @Html.AntiForgeryToken()
                                <div class="add-member-input-wrap">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="MemberEmail" placeholder="Email do membro"/>
                                </div>
                                <button id="btn-add" type="submit" asp-page-handler="AddMember" class="add-member-btn">
                                    <i class="bi bi-person-plus"></i> Adicionar
                                </button>
                            </form>
                        }

                        <form id="antiForgeryForm" method="post" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>
                        <script>
                            const addMemberForm = document.getElementById('form-add-member');

                            if (addMemberForm) {
                                addMemberForm.addEventListener('submit', async (e) => {
                                    e.preventDefault();

                                    const formData = new FormData(addMemberForm);
                                    const token = addMemberForm.querySelector('input[name="__RequestVerificationToken"]').value;

                                    const response = await fetch(window.location.pathname + '?handler=AddMember', {
                                        method: 'POST',
                                        headers: {
                                            'RequestVerificationToken': token
                                        },
                                        body: formData
                                    });

                                    const data = await response.json();
                                    mostrarToast(
                                        data.success ? "Informação" : "Erro",
                                        data.message,
                                        data.success ? "success" : "danger"
                                    );

                                    if (data.success) {
                                        addMemberForm.reset();
                                    }
                                });
                            }
                        </script>
                    }
                    else
                    {
                        <p class="org-empty">Ainda não há membros.</p>
                    }
                </div>
            </div>
        </div>
        <!-- Back -->
        <a asp-page="Index" class="org-back">
            <i class="bi bi-arrow-left"></i> Voltar às organizações
        </a>

        <!-- Create Post AJAX -->
        <script>
            (function () {
                // Gets the many elements
                const form = document.getElementById('form-create-post');
                const btnToggle = document.getElementById('btn-toggle-post');
                const btnCancel = document.getElementById('btn-cancel-post');
                const textarea = document.querySelector('.create-post-content');
                const charCurrent = document.getElementById('char-current');
                const empty = document.getElementById('post-placeholder');

                // Verifies that the elements exist
                if (btnToggle && form) {
                    function toggleForm() {
                        const isHidden = form.style.display === 'none';
                        form.style.display = isHidden ? 'block' : 'none';
                        if (empty) empty.style.display = isHidden ? 'none' : 'block';
                        if (isHidden && textarea) textarea.focus();
                    }


                    // Add the event to the buttons
                    btnToggle.addEventListener('click', toggleForm);
                    btnCancel.addEventListener('click', toggleForm);

                    // Character counter
                    textarea.addEventListener('input', () => {
                        charCurrent.textContent = textarea.value.length;
                    });

                    // AJAX submit
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        const formData = new FormData(form);
                        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                        const response = await fetch(window.location.pathname + '?handler=CreatePost', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });
                        // API response
                        const data = await response.json();
                        // Shows toast
                        mostrarToast(data.success ? "Sucesso" : "Erro", data.message, data.success ? "success" : "danger");
                        if (data.success) {
                            setTimeout(() => location.reload(), 800);
                        }
                    });
                }

                // Delete post handlers
                document.querySelectorAll('.pub-delete-btn').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        //gets the postId from the post
                        const postId = btn.dataset.postId;

                        //confirms the action
                        if (!await confirmModal('Tens a certeza que queres remover esta publicação?', 'Eliminar')) return;

                        // Query the anti forgery token, required by ASP.NET for security
                        const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
                        
                        try {
                            // Sends the post to the api
                            const response = await fetch(`${window.location.pathname}?handler=DeletePost&postId=${encodeURIComponent(postId)}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': token
                                },
                            });
                            // Response
                            const data = await response.json();
                            // Shows result
                            mostrarToast(data.success ? "Sucesso" : "Erro", data.message, data.success ? "success" : "danger");
                            if (data.success) {
                                // looks for the closest element with the class and removes it
                                const postEl = btn.closest('.pub-post');
                                if (postEl) postEl.remove();
                            }
                        } catch (err) {
                            mostrarToast("Erro", "Falha ao remover a publicação.", "danger");
                        }
                    });
                });

                // -------- Create Project Form --------
                const projectForm = document.getElementById('form-create-project');
                const btnToggleProject = document.getElementById('btn-toggle-project');
                const btnCancelProject = document.getElementById('btn-cancel-project');
                const projectTextarea = document.querySelector('.create-project-description');
                const projectCharCurrent = document.getElementById('project-char-current');
                const projectEmpty = document.getElementById('project-placeholder');
                const projectCheckbox = document.querySelector('input[name="NewProjectPublic"]');
                const visibilityText = document.getElementById('visibility-text');

                if (btnToggleProject && projectForm) {
                    function toggleProjectForm() {
                        const isHidden = projectForm.style.display === 'none';
                        projectForm.style.display = isHidden ? 'block' : 'none';
                        if (projectEmpty) projectEmpty.style.display = isHidden ? 'none' : 'block';
                        if (isHidden && projectTextarea) projectTextarea.focus();
                    }

                    btnToggleProject.addEventListener('click', toggleProjectForm);
                    btnCancelProject.addEventListener('click', toggleProjectForm);

                    // Character counter
                    projectTextarea.addEventListener('input', () => {
                        projectCharCurrent.textContent = projectTextarea.value.length;
                    });

                    // Visibility toggle
                    projectCheckbox.addEventListener('change', () => {
                        if (visibilityText) {
                            visibilityText.textContent = projectCheckbox.checked ? 'Público' : 'Privado';
                            const icon = visibilityText.previousElementSibling;
                            if (icon) {
                                icon.className = projectCheckbox.checked ? 'bi bi-globe2' : 'bi bi-lock';
                            }
                        }
                    });

                    // AJAX submit
                    projectForm.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        const formData = new FormData(projectForm);
                        const token = projectForm.querySelector('input[name="__RequestVerificationToken"]').value;

                        const response = await fetch(window.location.pathname + '?handler=CreateProject', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });
                        const data = await response.json();
                        mostrarToast(data.success ? "Sucesso" : "Erro", data.message, data.success ? "success" : "danger");
                        if (data.success) {
                            setTimeout(() => location.reload(), 800);
                        }
                    });
                }
            })();

            //Interceta o submit de qualquer formulário de upgrade
            document.addEventListener('submit', async e => {
                const form = e.target;

                //Ignora formulário que não sejam upgrade
                if (!form.classList.contains('upgrade-member-form')) return;
                e.preventDefault();
                
                const formData = new FormData(form);
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
                try {
                    //Envia o pedido ao handler UpgradeMember via AJAX
                    const res = await fetch(window.location.pathname + '?handler=UpgradeMember', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });
                    const response = await res.json();

                    //Mostra toast de sucesso ou erro
                    mostrarToast(
                        response.success ? 'Informação' : 'Erro',
                        response.message,
                        response.success ? 'success' : 'danger'
                    );

                    //Atualiza o badge do role na UI
                    if (response.success) {
                        const memberId = form.querySelector('[name="memberId"]').value;
                        const roleSpan = document.querySelector(`#row-${memberId} .member-role`);

                        if (roleSpan) roleSpan.textContent = response.newRole;
                    }
                } catch (err) {
                    //Erro de rede ou responsta inválida
                    mostrarToast('Erro', 'Não foi possível comunicar com o servidor', 'danger');
                }
            })
        </script>
        <script>
            document.addEventListener("submit", async (e) => {
                const form = e.target;
                if (!form.classList.contains("remove-member-form")) return;

                e.preventDefault();
                const user = form.user.value;

                if (!await confirmModal('Tem a certeza que quer remover ' + user + ' da organização?', 'Eliminar')) return;

                const formData = new FormData(form);
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    const res = await fetch(window.location.pathname + '?handler=RemoveMember', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    const response = await res.json();

                    if (response.success) {
                        mostrarToast("Informação", response.message, "success");
                        setTimeout(() => location.reload(), 500);
                    }
                } catch (err) {
                    mostrarToast("Erro", "Não foi possível comunicar com o servidor.", "danger");
                }
            });
        </script>
    </div>
}