@page "{id}"
@using Skillbridge.Models.Client
@model Skillbridge.Pages.Organization.ProfileModel
@{
    ViewData["Title"] = Model.Organization?.OrganizationName;
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/pages/OrganizationProfile.css" asp-append-version="true" />

@if (Model.Organization != null)
{
    <div class="org-profile">

        <!-- Banner -->
        <img src="@Model.Organization.BannerPath" alt="Banner" class="org-banner" />

        <!-- Header of organization -->
        <div class="org-header">
            <img src="@Model.Organization.LogoPath" alt="@Model.Organization.OrganizationName" class="org-logo"/>
            <div class="org-header-info">
                <h1 class="org-name">@Model.Organization.OrganizationName</h1>
                <p class="org-address">
                    <i class="bi bi-geo-alt"></i>
                    @Model.Organization.OrganizationAddress
                </p>
                @if (!string.IsNullOrEmpty(Model.Organization.OrganizationOwner?.Name))
                {
                    <span class="org-owner-badge">
                        <i class="bi bi-person-fill-gear"></i>
                        Fundador: @Model.Organization.OrganizationOwner.Name
                    </span>
                }
            </div>
        </div>

        <!-- Two Column Layout -->
        <div class="org-main">

            <!-- Left Column is About + Projects -->
            <div>
                <!-- About -->
                <div class="org-card">
                    <h2 class="org-card-title">
                        <i class="bi bi-info-circle"></i> Sobre
                    </h2>
                    @if (!string.IsNullOrEmpty(Model.Organization.OrganizationDescription))
                    {
                        <p class="org-description">@Model.Organization.OrganizationDescription</p>
                    }
                    else
                    {
                        <p class="org-empty">Sem descrição disponível.</p>
                    }
                </div>

                <!-- Publications -->
                <div class="org-card" style="margin-top: 24px;">
                    <h2 class="org-card-title">
                        <i class="bi bi-megaphone"></i> Publicações
                    </h2>
                    @if (Model.Posts != null && Model.Posts.Count > 0)
                    {
                        <div class="pub-list">
                            @foreach (var post in Model.Posts)
                            {
                                <div class="pub-post">
                                    <div class="pub-post-header">
                                        <h3 class="pub-post-title">@post.Title</h3>
                                        <span class="pub-post-date">
                                            <i class="bi bi-calendar3"></i>
                                            @post.Created.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    <p class="pub-post-content">@post.Content</p>
                                    @if (!string.IsNullOrEmpty(post.AuthorName))
                                    {
                                        <div class="pub-post-author">
                                            <i class="bi bi-person"></i>
                                            Publicado por @post.AuthorName
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pub-placeholder">
                            <i class="bi bi-newspaper"></i>
                            <p>Em breve — anúncios e publicações da organização aparecerão aqui.</p>
                        </div>
                    }
                </div>

                <!-- Projects -->
                <div class="org-card" style="margin-top: 24px;">
                    <h2 class="org-card-title">
                        <i class="bi bi-code-square"></i> Projetos
                        @if (Model.Projects.Count > 0)
                        {
                            <span class="project-badge public" style="margin-left: auto;">@Model.Projects.Count</span>
                        }
                    </h2>
                    @if (Model.Projects.Count > 0)
                    {
                        <div class="projects-grid">
                            @foreach (var project in Model.Projects)
                            {
                                <a asp-page="/Project/Index" asp-route-id="@project.Id" class="project-card">
                                    <h3 class="project-name">@project.Name</h3>
                                    <p class="project-desc">@project.Description</p>
                                    <span class="project-badge @(project.IsPublic ? "public" : "private")">
                                        <i class="bi bi-@(project.IsPublic ? "globe2" : "lock")"></i> @(project.IsPublic ? "Público" : "Privado")
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="org-empty">Esta organização ainda não tem projetos.</p>
                    }
                </div>
            </div>

            <!-- Right Column is nembers of organization -->
            <div>
                <div class="org-card">
                    <h2 class="org-card-title">
                        <i class="bi bi-people"></i> Membros
                        @if (Model.Members.Count > 0)
                        {
                            <span class="project-badge public" style="margin-left: auto;">@Model.Members.Count</span>
                        }
                    </h2>
                    @if (Model.Members.Count > 0)
                    {
                        <div class="members-list">
                            @foreach (var member in Model.Members)
                            {
                                <div class="member-row">
                                    <div class="member-avatar">
                                        @(member.Name?.Length > 0 ? member.Name[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <p class="member-name">@member.Name <span class="member-role">@member.Role</span></p>
                                        <p class="member-email">@member.Email</p>
                                    </div>
                                </div>
                            }
                        </div>
                        <form id="form-add-member" method="post" class="add-member-form">
                            <div class="add-member-input-wrap">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="MemberEmail" placeholder="Email do membro" />
                            </div>
                            <button id="btn-add" type="submit" asp-page-handler="AddMember" class="add-member-btn">
                                <i class="bi bi-person-plus"></i> Adicionar
                            </button>
                        </form>
                        <script>
                        document.getElementById('form-add-member').addEventListener('submit', async (e) => {
                            e.preventDefault();
    
                            const formData = new FormData(e.target);
    
                            const response = await fetch(window.location.pathname + '?handler=AddMember', {
                                method: 'POST',
                                body: formData
                            });
    
                            const data = await response.json();
                            mostrarToast(data.success ? "Informação" : "Erro", data.message, data.success ? "success" : "danger");
    
                            if (data.success) {
                                e.target.reset(); // limpa o input do email
                            }
                        });
    
                        function mostrarToast(titulo, mensagem, tipo) {
                            const toastEl = document.createElement('div');
                            toastEl.className = `toast align-items-center text-bg-${tipo} border-0`;
                            toastEl.setAttribute('role', 'alert');
                            toastEl.innerHTML = `
                                <div class="d-flex">
                                    <div class="toast-body"><strong>${titulo}:</strong> ${mensagem}</div>
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                                </div>
                            `;
    
                            let container = document.getElementById('toast-container');
                            if (!container) {
                                container = document.createElement('div');
                                container.id = 'toast-container';
                                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                                document.body.appendChild(container);
                            }
    
                            container.appendChild(toastEl);
                            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                            toast.show();
    
                            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
                        }
                        </script>
                        
                    }
                    else
                    {
                        <p class="org-empty">Ainda não há membros.</p>
                    }
                </div>
            </div>
        </div>
        <!-- Back -->
        <a asp-page="Index" class="org-back">
            <i class="bi bi-arrow-left"></i> Voltar às organizações
        </a>
    </div>
}
