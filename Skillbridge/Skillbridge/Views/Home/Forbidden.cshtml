@{
    ViewData["Title"] = "403 - Acesso Proibido";
}

<link rel="stylesheet" href="~/css/shared/error.css" asp-append-version="true" />

<div class="error-page">
    <div class="error-content">
        <!-- Código de erro -->
        <div class="error-code">403</div>
        <!-- GIF meme com efeito de brilho -->
        <div class="error-gif-wrapper">
            <div class="error-gif-glow"></div>
            <img
                src="https://media1.tenor.com/m/sPKmCiqldCEAAAAC/nuh-uh.gif"
                alt="Nuh Uh - Scout TF2 Meme"
                class="error-gif"
                loading="eager"
            />
        </div>
        <!-- Mensagem de erro -->
        <h1 class="error-title">Nuh Uh!</h1>
        <p class="error-subtitle">Não tens permissão para aceder a esta página. Vai dar uma volta. 🚫</p>
        <!-- Botão de ação -->
        <a asp-area="" asp-controller="Home" asp-action="Index" class="error-btn" id="forbidden-go-home-btn">
            <i class="bi bi-house-door-fill"></i>
            <span>Voltar ao Início</span>
        </a>
    </div>
</div>