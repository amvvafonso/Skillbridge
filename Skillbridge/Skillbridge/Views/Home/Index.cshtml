@{
  ViewData["Title"] = "Skillbridge";
}
<link rel="stylesheet" href="~/css/pages/Home.css" asp-append-version="true">
<div class="home-banner-div">
    
    <div class="banner-header-div">
        <h1 class="banner-header-title">Constrói a ponte entre a teoria e a prática</h1>
        <p class="banner-header-text">Acompanhe o trabalho de engenheiros seniores de empresas tecnológicas de primeira linha. Aceda a repositórios de produçao, assista a revisões de arquitetura em direto e melhore a sua capacidade de tomada de decisões técnicas.</p>
        <div class="d-flex gap-3 w-100">
            <button class="header-button">Começar</button>
            <button id="about" class="header-button">Ver mais</button>
        </div>
    </div>
    <div class="w-100 h-100 align-content-center">
        <img class="object-fit-contain w-100 opacity-50" src="banner-image.png" alt="Home banner image"/>
    </div>
    <div class="blur"></div>
</div>

