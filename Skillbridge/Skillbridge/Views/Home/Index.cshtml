@{
  ViewData["Title"] = "Skillbridge";
}
<link rel="stylesheet" href="~/css/pages/Home.css" asp-append-version="true">
<div class="home-banner-div">
    
    <div class="banner-header-div">
        <h1 class="banner-header-title">Bridge the Gap Between Theory and Practice</h1>
        <p class="banner-header-text"> Shadow senior engineers from top-tier tech companies. Access production repositories, watch live architecture reviews, and level up your technical decision-making.</p>
        <div class="d-flex gap-3 w-100">
            <button class="header-button">Começar</button>
            <button id="about" class="header-button">Ver mais</button>
        </div>
    </div>
    <div class="w-100 h-100 align-content-center">
        <img class="object-fit-contain w-100 opacity-50" src="banner-image.png" alt="Home banner image, code example"/>
    </div>
    <div class="blur"></div>
</div>

