@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<link rel="stylesheet" href="~/css/shared/error.css" asp-append-version="true" />

<div class="error-page">
    <div class="error-content">
        <!-- Código de erro -->
        <div class="error-code">ERRO</div>
        <!-- GIF meme com efeito de brilho -->
        <div class="error-gif-wrapper">
            <div class="error-gif-glow"></div>
            <img
                src="https://media1.tenor.com/m/sPKmCiqldCEAAAAC/nuh-uh.gif"
                alt="Nuh Uh - Scout TF2 Meme"
                class="error-gif"
                loading="eager"
            />
        </div>
        <!-- Mensagem de erro -->
        <h1 class="error-title">Nuh Uh!</h1>
        <p class="error-subtitle">Algo correu mal... mas ninguém vai admitir. 😏</p>
        @if (Model?.ShowRequestId == true)
        {
            <div class="error-request-id">
                <span class="error-request-label">ID do Pedido:</span>
                <code class="error-request-code">@Model.RequestId</code>
            </div>
        }
        <!-- Botão de ação -->
        <a asp-area="" asp-controller="Home" asp-action="Index" class="error-btn" id="error-go-home-btn">
            <i class="bi bi-house-door-fill"></i>
            <span>Voltar ao Início</span>
        </a>
    </div>
</div>
}