@using Skillbridge.Utilities
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Skillbridge</title>
    <script type="importmap"></script>
    <!-- No <head>, adicione o CSS do tema escolhido -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />

    <!-- No final do <body>, adicione o JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <!-- Adicione linguagens extras se necessário (Ex: C#) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Skillbridge.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="css/shared/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <script src="~/js/Toast.js" asp-append-version="true" defer></script>

</head>
<body style="font-family: Inter; background-color: rgb(8, 20, 37)">
<header>
    <nav class="navbar navbar-div navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow">
        <div class="container-fluid h-100">

            <a class="navbar-brand text-white h-100" asp-area="" asp-controller="Home" asp-action="Index"> <img class="object-fit-contain h-100" alt="Logo da skillbridge" src="/logo.png"/></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center text-center">
                <ul class="navbar-nav flex-grow-1 justify-content-center">
                    <li class="nav-item">
                        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li><a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" href="/Organization">Organizações</a>

                    </li>
                    <li class="nav-item">
                        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="" asp-controller="Info" asp-action="HowItWorks">Como funciona</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                    <li class="nav-item">
                        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="" asp-controller="Client" asp-action="Index">Área pessoal</a>
                    </li>
                    }
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<div>
    <main role="main">
        <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
            @{
            var bgClass = TempData["ToastType"]?.ToString() == "danger" ? "bg-danger text-white" :
            TempData["ToastType"]?.ToString() == "warning" ? "bg-warning text-dark" : "bg-success text-white";
            }
            <div id="globalToast" class="toast align-items-center @bgClass border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                <div class="d-flex">
                    <div class="toast-body">
                        @if (TempData["ToastMessage"] != null)
                        {
                        <strong>@TempData["ToastTitle"]</strong>
                        <br />
                        @TempData["ToastMessage"]
                        }
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>

        @if (TempData["ToastMessage"] != null)
        {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var toastEl = document.getElementById('globalToast');
                var toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            });
        </script>
        }
        <div id="loading-screen">
            <div class="spinner"></div>
        </div>
        @RenderBody()
    </main>
</div>
<div class="modal fade" id="meuModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmação</h5>
            </div>

            <div class="modal-body">
                Deseja continuar?
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary">
                    Confirmar
                </button>
            </div>

        </div>
    </div>
</div>
<footer class="footer text-muted">
    <div class="container" style="text-align: center; color: rgb(217, 228, 252);">
        &copy; 2026 - Skillbridge
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

<!-- Loading screen -->
<script>
    window.addEventListener('load', function () {
        const loader = document.getElementById('loading-screen');

        setTimeout(() => {
            loader.style.opacity = '0';
            setTimeout(() => {
                loader.style.display = 'none';
            }, 200);
        }, 100);
    });
</script>

<!-- SignalR setup -->
<!-- Fetches js from web-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<script>
    // Creates connection
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();
    
    // Starts connection
    async function start() {
        try {
            await connection.start();
            console.log("SignalR Connected.");
        } catch (err) {
            console.log(err);
            setTimeout(start, 5000);
        }
    };
    
    // Gets toast element by id
    const toast = document.getElementById('globalToast');
    const toastBootstrap = toast ? bootstrap.Toast.getOrCreateInstance(toast) : null;
    
    // Every time it calls the function ReceiveNotification it renders the toast with the message
    connection.on('ReceiveNotification', function (message) {
        console.log(message);
        if (!toastBootstrap) return;
        const body = toast.querySelector('.toast-body');
        if (body) body.textContent = message;
        toastBootstrap.show();
    });

    connection.onclose(async () => {
        await start();
    });

    // Start the connection.
    start();
</script>
</body>
</html>