@using Skillbridge.Utilities
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Skillbridge</title>
    <script type="importmap"></script>
    <!-- No <head>, adicione o CSS do tema escolhido -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />

    <!-- No final do <body>, adicione o JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <!-- Adicione linguagens extras se necessário (Ex: C#) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Skillbridge.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/shared/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <script src="~/js/Toast.js" asp-append-version="true" defer></script>

    <!-- Responsive rules handled in navbar.css -->
</head>
<body style="font-family: Inter; background-color: rgb(8, 20, 37)">
<header>
    <nav class="navbar navbar-div navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow">
        <div class="container-fluid h-100">

            <a class="navbar-brand text-white h-100" asp-area="" asp-controller="Home" asp-action="Index"> <img class="object-fit-contain h-100" alt="Logo da skillbridge" src="/logo.png"/></a>

            <!-- Animated Hamburger Button (mobile only) -->
            <button class="mobile-menu-toggle" type="button" aria-label="Alternar navegação" aria-expanded="false">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>

            <!-- Bootstrap toggler (hidden on mobile, replaced by custom hamburger) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Desktop nav (Bootstrap collapse for <768px) -->
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center text-center">
                <ul class="navbar-nav flex-grow-1 justify-content-center">
                    <li class="nav-item">
                        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                    </li>
                    <li><a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" href="/Organization">Organizações</a></li>
                    <li class="nav-item">
                        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" href="/FAQ">Como funciona</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                    <li class="nav-item">
                        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="" asp-controller="Client" asp-action="Index">Área pessoal</a>
                    </li>
                    }
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>

    <!-- Mobile Overlay Menu -->
    <div class="mobile-overlay" id="mobileOverlay"></div>
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-inner">
            <ul class="mobile-nav-list">
                <li class="mobile-nav-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="mobile-link">
                        <i class="bi bi-house-door"></i>
                        <span>Início</span>
                    </a>
                </li>
                <li class="mobile-nav-item">
                    <a href="/Organization" class="mobile-link">
                        <i class="bi bi-buildings"></i>
                        <span>Organizações</span>
                    </a>
                </li>
                <li class="mobile-nav-item">
                    <a href="/FAQ" class="mobile-link">
                        <i class="bi bi-lightbulb"></i>
                        <span>Como funciona</span>
                    </a>
                </li>
                @if (User.Identity.IsAuthenticated)
                {
                <li class="mobile-nav-item">
                    <a asp-area="" asp-controller="Client" asp-action="Index" class="mobile-link">
                        <i class="bi bi-person-circle"></i>
                        <span>Área pessoal</span>
                    </a>
                </li>
                }
            </ul>

            @if (User.Identity.IsAuthenticated)
            {
            <div class="mobile-auth-section">
                <div class="mobile-user-info">
                    <div class="mobile-user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="mobile-user-details">
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="mobile-user-name" title="Gerir conta">Olá @(User.Identity.Name ?? "Utilizador")!</a>
                        <span class="mobile-user-status">Utilizador Logado</span>
                    </div>
                </div>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="mobile-logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Terminar sessão</span>
                    </button>
                </form>
            </div>
            }
            else
            {
            <div class="mobile-auth-section">
                <a asp-area="Identity" asp-page="/Account/Login" class="mobile-auth-btn mobile-auth-btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Entrar
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="mobile-auth-btn mobile-auth-btn-secondary">
                    <i class="bi bi-pencil-square"></i>
                    Registar
                </a>
            </div>
            }
        </div>
    </div>
</header>

<!-- Mobile Menu JS -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.querySelector('.mobile-menu-toggle');
        const menu = document.getElementById('mobileMenu');
        const overlay = document.getElementById('mobileOverlay');
        const body = document.body;

        function openMobileMenu() {
            menu.classList.add('open');
            overlay.classList.add('open');
            toggle.classList.add('active');
            toggle.setAttribute('aria-expanded', 'true');
            body.style.overflow = 'hidden';
        }

        function closeMobileMenu() {
            menu.classList.remove('open');
            overlay.classList.remove('open');
            toggle.classList.remove('active');
            toggle.setAttribute('aria-expanded', 'false');
            body.style.overflow = '';
        }

        toggle.addEventListener('click', function() {
            const isOpen = menu.classList.contains('open');
            if (isOpen) closeMobileMenu();
            else openMobileMenu();
        });

        overlay.addEventListener('click', closeMobileMenu);

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && menu.classList.contains('open')) closeMobileMenu();
        });

        document.querySelectorAll('.mobile-link').forEach(function(link) {
            link.addEventListener('click', closeMobileMenu);
        });
    });
</script>
<div>
    <main role="main">
        <div id="toast-container" class="toast-container position-fixed bottom-2 end-0 p-3 z-1" style="z-index: 1100">
            @{
            var bgClass = TempData["ToastType"]?.ToString() == "danger" ? "bg-danger text-white" :
            TempData["ToastType"]?.ToString() == "warning" ? "bg-warning text-dark" : "bg-success text-white";
            }
            <div id="globalToast" class="toast align-items-center @bgClass border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                <div class="d-flex">
                    <div class="toast-body">
                        @if (TempData["ToastMessage"] != null)
                        {
                        <strong>@TempData["ToastTitle"]</strong>
                        <br />
                        @TempData["ToastMessage"]
                        }
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        </div>

        @if (TempData["ToastMessage"] != null)
        {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var toastEl = document.getElementById('globalToast');
                var toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            });
        </script>
        }
        <div id="loading-screen">
            <div class="spinner"></div>
        </div>
        @RenderBody()
    </main>
</div>
<div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="globalConfirmTitle">
                    <i class="bi bi-exclamation-triangle me-2" style="color: var(--primary)"></i>
                    Confirmação
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <div class="modal-body" id="globalConfirmBody">
                Deseja continuar?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" id="globalConfirmCancelBtn" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn" id="globalConfirmBtn">
                    Confirmar
                </button>
            </div>

        </div>
    </div>
</div>
<footer class="footer text-muted">
    <div class="container" style="text-align: center; color: rgb(217, 228, 252);">
        &copy; 2026 - Skillbridge
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

<!-- Loading screen -->
<script>
    window.addEventListener('load', function () {
        const loader = document.getElementById('loading-screen');

        setTimeout(() => {
            loader.style.opacity = '0';
            setTimeout(() => {
                loader.style.display = 'none';
            }, 200);
        }, 100);
    });
</script>

<!-- SignalR setup -->
<!-- Fetches js from web-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<script>
    // Creates connection
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();
    
    // Starts connection
    async function start() {
        try {
            await connection.start();
            console.log("SignalR Connected.");
        } catch (err) {
            console.log(err);
            setTimeout(start, 5000);
        }
    };
    
    // Gets toast element by id
    const toast = document.getElementById('globalToast');
    const toastBootstrap = toast ? bootstrap.Toast.getOrCreateInstance(toast) : null;
    
    // Every time it calls the function ReceiveNotification it renders the toast with the message
    connection.on('ReceiveNotification', function (message) {
        console.log(message);
        if (!toastBootstrap) return;
        const body = toast.querySelector('.toast-body');
        if (body) body.textContent = message;
        toastBootstrap.show();
    });

    connection.onclose(async () => {
        await start();
    });

    // Start the connection.
    start();
</script>
<script>
    // Confirm dialog for middle of function
    function confirmModal(message = "Deseja continuar?", title = "Confirmação") {
        return new Promise((resolve) => {
            const modalEl = document.getElementById("globalConfirmModal");
            const modal = new bootstrap.Modal(modalEl);

            document.getElementById("globalConfirmTitle").textContent = title;
            document.getElementById("globalConfirmBody").textContent = message;

            const confirmBtn = document.getElementById("globalConfirmBtn");
            const cancelBtn = document.getElementById("globalConfirmCancelBtn");

            const onConfirm = () => {
                cleanup();
                modal.hide();
                resolve(true);
            };

            const onCancel = () => {
                cleanup();
                resolve(false);
            };

            const onHidden = () => {
                cleanup();
                resolve(false);
            };

            function cleanup() {
                confirmBtn.removeEventListener("click", onConfirm);
                cancelBtn.removeEventListener("click", onCancel);
                modalEl.removeEventListener("hidden.bs.modal", onHidden);
            }

            confirmBtn.addEventListener("click", onConfirm);
            cancelBtn.addEventListener("click", onCancel);
            modalEl.addEventListener("hidden.bs.modal", onHidden, { once: true });

            modal.show();
        });
    }
</script>

<script>
    // Confirm dialog for onsubmit field
    let formToSubmit = null;

    function openConfirmModal(form, message = "Deseja continuar?", title = "Confirmação") {
        formToSubmit = form;

        document.getElementById("globalConfirmTitle").textContent = title;
        document.getElementById("globalConfirmBody").textContent = message;

        const modalElement = document.getElementById("globalConfirmModal");
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const confirmBtn = document.getElementById("globalConfirmBtn");

        if (confirmBtn) {
            confirmBtn.addEventListener("click", function () {
                if (formToSubmit) {
                    formToSubmit.submit();
                    formToSubmit = null;
                }
            });
        }
    });
</script>
</body>
</html>