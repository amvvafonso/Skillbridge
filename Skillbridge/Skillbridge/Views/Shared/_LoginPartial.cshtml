@using Microsoft.AspNetCore.Identity
@using Skillbridge.Models.Client
@using Microsoft.EntityFrameworkCore
@using System.Linq

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject Skillbridge.Data.ApplicationDbContext context

@{
    List<Notification> Model = new List<Notification>();
    var user = await UserManager.GetUserAsync(User);
    if (user != null)
    {
        Model = await context.Notifications
            .Where(p => p.UserId == user.Id && !p.Hidden)
            .ToListAsync();
    }
}

<style>
    .dropdown-hover:hover .dropdown-menu { display: block; margin-top: 0; }
    .notification-btn { cursor: pointer; padding: 8px; transition: transform 0.2s; }
    .notification-btn:hover { transform: scale(1.1); }
</style>

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown dropdown-hover align-content-center text-center me-3 position-relative">
            <a class="nav-link notification-btn" id="notificationDropdown" role="button" aria-expanded="false">
                <i class="bi bi-bell text-white fs-5"></i>

                @if (Model.Any())
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="margin-top: 5px; margin-left: -10px;">
                        @Model.Count
                    </span>
                }
            </a>

            <ul style="background-color: rgba(8, 20, 37); min-width: 300px;" class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationDropdown">
                <li class="dropdown-header fw-bold border-bottom pb-2 text-color fs-4">Notificações</li>

                @if (Model.Any())
                {
                    @foreach (var notificacao in Model)
                    {
                        if (notificacao.Type == NotificationType.Information)
                        {
                            <li class="notification-bk">
                                <a class="dropdown-item py-2 border-bottom" href="#">
                                    <small class="text-muted d-block">@notificacao.Date.ToString("dd/MM HH:mm")</small>
                                    <span class="text-wrap d-block small">@notificacao.Body</span>
                                </a>
                            </li>
                        }
                        else if (notificacao.Type == NotificationType.OrganizationInvite)
                        {
                            <li class="notification-bk">
                                <a class="dropdown-item py-2 border-bottom notification-bk">
                                    <small class="d-block text-color">@notificacao.Date.ToString("dd/MM HH:mm")</small>
                                    <span class="text-wrap d-block small text-color">@notificacao.Body</span>
                                    <div class="w-100 d-flex gap-1">
                                        <form asp-area="" asp-controller="Notification" asp-action="AcceptInvite" method="post">
                                            <input type="hidden" name="notificationId" value="@notificacao.NotificationId" />
                                            <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Path" />
                                            <button type="submit" class="notification-button">Aceitar</button>
                                        </form>
                                        <form asp-area="" asp-controller="Notification" asp-action="Decline" method="post">
                                            <input type="hidden" name="notificationId" value="@notificacao.NotificationId" />
                                            <button type="submit" class="notification-button">Recusar</button>
                                        </form>
                                    </div>
                                </a>
                            </li>
                        }
                    }
                }
                else
                {
                    <li><span class="dropdown-item text-muted text-center py-3 small">Não tens novas notificações</span></li>
                }
            </ul>
        </li>

    <li class="nav-item">
        <a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gerir conta">Olá @user?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button style="color: rgb(142, 157, 177)" type="submit" class="nav-link btn btn-link btn-hover">Terminar sessão</button>
        </form>
    </li>
    }
    else
    {
    <li class="nav-item"><a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="Identity" asp-page="/Account/Register">Registar</a></li>
    <li class="nav-item"><a style="color: rgb(142, 157, 177)" class="nav-link btn-hover" asp-area="Identity" asp-page="/Account/Login">Entrar</a></li>
    }
</ul>